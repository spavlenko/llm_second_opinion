{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunConfig",
  "$defs": {
    "AdvisorSettings": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/Level"
        },
        "interventions": {
          "items": {
            "$ref": "#/$defs/Intervention"
          },
          "type": "array"
        },
        "prompts": {
          "default": "default",
          "description": "Name of a prompt set in the experiment's `prompts`.",
          "type": "string"
        },
        "max_consults": {
          "default": 5,
          "minimum": 0,
          "type": "integer"
        },
        "max_answer_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 4000,
          "description": "Safety ceiling on each advisor answer (sent as max_tokens); reaching it is logged. The working limit is the prompt's target, `answer_target_words`."
        },
        "answer_target_words": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 250,
          "description": "Answer length the advisor is asked for, in the prompt."
        },
        "max_brief_tokens": {
          "default": 3000,
          "description": "Safety ceiling on a brief; cutting it is logged.",
          "minimum": 1,
          "type": "integer"
        },
        "field_target_words": {
          "default": 80,
          "description": "Length the consult tool asks for in each field the executor writes.",
          "minimum": 1,
          "type": "integer"
        },
        "orient_after": {
          "default": 3,
          "description": "Own read actions before the `orient` trigger fires.",
          "minimum": 1,
          "type": "integer"
        },
        "rules": {
          "$ref": "#/$defs/ConsultRules"
        },
        "cooldown_turns": {
          "default": 0,
          "description": "Turns after a consult before a harness trigger may fire.",
          "minimum": 0,
          "type": "integer"
        },
        "periodic_every": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Turns between `periodic` triggers."
        },
        "stuck": {
          "$ref": "#/$defs/StuckThresholds"
        }
      },
      "required": [
        "level",
        "interventions",
        "prompts",
        "max_consults",
        "max_answer_tokens",
        "answer_target_words",
        "max_brief_tokens",
        "field_target_words",
        "orient_after",
        "rules",
        "cooldown_turns",
        "periodic_every",
        "stuck"
      ],
      "title": "AdvisorSettings",
      "type": "object"
    },
    "ConsultRules": {
      "additionalProperties": false,
      "description": "Anti-delegation: the executor must do its own work between consults. Strictness is an\narm setting, so experiments can compare strict and loose rules.",
      "properties": {
        "min_own_actions": {
          "default": 1,
          "description": "Own tool calls since the last consult before the next.",
          "minimum": 0,
          "type": "integer"
        },
        "tool_cooldown_turns": {
          "default": 2,
          "description": "Turns after a consult before the consult tool may be used.",
          "minimum": 0,
          "type": "integer"
        },
        "require_hypothesis": {
          "default": true,
          "description": "The consult tool refuses a request without `tried` and `hypothesis` written by the executor.",
          "type": "boolean"
        },
        "max_advice_code_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 5,
          "description": "Code blocks in advice longer than this are cut before injection (0: no code at all; None: no limit). advice_text keeps the original."
        }
      },
      "title": "ConsultRules",
      "type": "object",
      "required": [
        "min_own_actions",
        "tool_cooldown_turns",
        "require_hypothesis",
        "max_advice_code_lines"
      ]
    },
    "Intervention": {
      "enum": [
        "plan",
        "consult",
        "stuck",
        "on_test_failure",
        "periodic",
        "orient",
        "before_done"
      ],
      "title": "Intervention",
      "type": "string"
    },
    "Level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "title": "Level",
      "type": "string"
    },
    "ModelEndpoint": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "api_key_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the environment variable holding the API key. Never the key itself."
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra request headers with non-secret values.",
          "type": "object"
        },
        "header_env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra request headers with secret values: header name to the name of the environment variable holding the value. Never the value itself.",
          "type": "object"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sampling temperature sent with every call; None: unset."
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sampling_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sampling seed sent with every call, if the server honours one. Unrelated to the experiment's `seeds`, which are replicate indices."
        }
      },
      "required": [
        "base_url",
        "model",
        "reasoning_effort",
        "api_key_env",
        "headers",
        "header_env",
        "temperature",
        "top_p",
        "sampling_seed"
      ],
      "title": "ModelEndpoint",
      "type": "object"
    },
    "PromptSet": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "hash": {
          "description": "16 hex chars of SHA-256 over the slot texts.",
          "type": "string"
        },
        "texts": {
          "$ref": "#/$defs/PromptTexts"
        }
      },
      "required": [
        "name",
        "hash",
        "texts"
      ],
      "title": "PromptSet",
      "type": "object"
    },
    "PromptTexts": {
      "additionalProperties": false,
      "description": "The text of every prompt slot, with `{{name}}` placeholders still in place.",
      "properties": {
        "executor_guidance": {
          "type": "string"
        },
        "consult_tool": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "advisor_system": {
          "type": "string"
        },
        "advice_injection": {
          "type": "string"
        }
      },
      "required": [
        "executor_guidance",
        "consult_tool",
        "brief",
        "advisor_system",
        "advice_injection"
      ],
      "title": "PromptTexts",
      "type": "object"
    },
    "RunIdentity": {
      "additionalProperties": false,
      "properties": {
        "experiment": {
          "type": "string"
        },
        "arm": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "config_hash": {
          "type": "string"
        }
      },
      "required": [
        "experiment",
        "arm",
        "task",
        "seed",
        "config_hash"
      ],
      "title": "RunIdentity",
      "type": "object"
    },
    "StuckThresholds": {
      "additionalProperties": false,
      "properties": {
        "repeat_calls": {
          "default": 3,
          "minimum": 1,
          "type": "integer"
        },
        "same_error": {
          "default": 3,
          "minimum": 1,
          "type": "integer"
        },
        "no_diff_turns": {
          "default": 8,
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "StuckThresholds",
      "type": "object",
      "required": [
        "repeat_calls",
        "same_error",
        "no_diff_turns"
      ]
    }
  },
  "additionalProperties": false,
  "description": "Written by the harness into the container as advisor.json.",
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/RunIdentity"
    },
    "executor": {
      "$ref": "#/$defs/ModelEndpoint"
    },
    "advisor_model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelEndpoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "advisor": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdvisorSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null when the arm runs without advisor interventions."
    },
    "prompts": {
      "anyOf": [
        {
          "$ref": "#/$defs/PromptSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The resolved prompt set of an advisor arm; null otherwise."
    },
    "events_path": {
      "default": "/run/events.jsonl",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run",
    "executor",
    "advisor_model",
    "advisor",
    "prompts",
    "events_path"
  ],
  "type": "object"
}
