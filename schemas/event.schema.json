{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "$defs": {
    "AdviceApplied": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per run, starting at 0.",
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "description": "Unix time in seconds.",
          "type": "number"
        },
        "type": {
          "const": "advice_applied",
          "default": "advice_applied",
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "turn": {
          "minimum": 0,
          "type": "integer"
        },
        "injected_text": {
          "description": "The exact text the executor was given.",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "request_id",
        "turn",
        "injected_text"
      ],
      "title": "AdviceApplied",
      "type": "object"
    },
    "AdvisorError": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per run, starting at 0.",
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "description": "Unix time in seconds.",
          "type": "number"
        },
        "type": {
          "const": "advisor_error",
          "default": "advisor_error",
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTP status; None if none came back."
        },
        "latency_ms": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "request_id",
        "message",
        "status",
        "latency_ms"
      ],
      "title": "AdvisorError",
      "type": "object"
    },
    "AdvisorRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per run, starting at 0.",
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "description": "Unix time in seconds.",
          "type": "number"
        },
        "type": {
          "const": "advisor_request",
          "default": "advisor_request",
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "input_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "brief_text": {
          "description": "The exact text sent to the advisor.",
          "type": "string"
        },
        "prompt_hash": {
          "description": "Hash of the prompt set that produced the request.",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "request_id",
        "input_tokens",
        "brief_text",
        "prompt_hash"
      ],
      "title": "AdvisorRequest",
      "type": "object"
    },
    "AdvisorResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per run, starting at 0.",
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "description": "Unix time in seconds.",
          "type": "number"
        },
        "type": {
          "const": "advisor_response",
          "default": "advisor_response",
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "cached_tokens": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "latency_ms": {
          "minimum": 0,
          "type": "number"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The provider's own count, when it reports one."
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "advice_text": {
          "description": "The advisor's answer exactly as received (placeholders not yet mapped back).",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "request_id",
        "output_tokens",
        "cached_tokens",
        "latency_ms",
        "prompt_tokens",
        "reasoning_tokens",
        "advice_text"
      ],
      "title": "AdvisorResponse",
      "type": "object"
    },
    "BriefBuilt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per run, starting at 0.",
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "description": "Unix time in seconds.",
          "type": "number"
        },
        "type": {
          "const": "brief_built",
          "default": "brief_built",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "identifiers_redacted": {
          "minimum": 0,
          "type": "integer"
        },
        "role_map_size": {
          "minimum": 0,
          "type": "integer"
        },
        "role_map": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Placeholder to real identifier, for every placeholder in this brief. Stays on the machine; the leakage and re-identification scorers need it.",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "level",
        "tokens",
        "identifiers_redacted",
        "role_map_size",
        "role_map"
      ],
      "title": "BriefBuilt",
      "type": "object"
    },
    "BudgetExhausted": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per run, starting at 0.",
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "description": "Unix time in seconds.",
          "type": "number"
        },
        "type": {
          "const": "budget_exhausted",
          "default": "budget_exhausted",
          "type": "string"
        },
        "consults_used": {
          "minimum": 0,
          "type": "integer"
        },
        "limit": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "consults_used",
        "limit"
      ],
      "title": "BudgetExhausted",
      "type": "object"
    },
    "ConsultRequested": {
      "additionalProperties": false,
      "description": "The executor called the consult tool.",
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per run, starting at 0.",
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "description": "Unix time in seconds.",
          "type": "number"
        },
        "type": {
          "const": "consult_requested",
          "default": "consult_requested",
          "type": "string"
        },
        "reason": {
          "description": "The executor's stated reason, as it wrote it.",
          "type": "string"
        },
        "turn": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "reason",
        "turn"
      ],
      "title": "ConsultRequested",
      "type": "object"
    },
    "Intervention": {
      "enum": [
        "plan",
        "consult",
        "stuck",
        "on_test_failure",
        "periodic"
      ],
      "title": "Intervention",
      "type": "string"
    },
    "Level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "title": "Level",
      "type": "string"
    },
    "PolicyRendered": {
      "additionalProperties": false,
      "description": "Emitted once at the start of an advisor run: the help-policy text the executor sees.",
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per run, starting at 0.",
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "description": "Unix time in seconds.",
          "type": "number"
        },
        "type": {
          "const": "policy_rendered",
          "default": "policy_rendered",
          "type": "string"
        },
        "prompt_hash": {
          "type": "string"
        },
        "executor_guidance": {
          "description": "As appended to the executor's system prompt.",
          "type": "string"
        },
        "consult_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The consult tool's description; None when the tool is not registered."
        }
      },
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "prompt_hash",
        "executor_guidance",
        "consult_tool"
      ],
      "title": "PolicyRendered",
      "type": "object"
    },
    "TriggerFired": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per run, starting at 0.",
          "minimum": 0,
          "type": "integer"
        },
        "ts": {
          "description": "Unix time in seconds.",
          "type": "number"
        },
        "type": {
          "const": "trigger_fired",
          "default": "trigger_fired",
          "type": "string"
        },
        "intervention": {
          "$ref": "#/$defs/Intervention"
        },
        "reason": {
          "type": "string"
        },
        "turn": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "intervention",
        "reason",
        "turn"
      ],
      "title": "TriggerFired",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "advice_applied": "#/$defs/AdviceApplied",
      "advisor_error": "#/$defs/AdvisorError",
      "advisor_request": "#/$defs/AdvisorRequest",
      "advisor_response": "#/$defs/AdvisorResponse",
      "brief_built": "#/$defs/BriefBuilt",
      "budget_exhausted": "#/$defs/BudgetExhausted",
      "consult_requested": "#/$defs/ConsultRequested",
      "policy_rendered": "#/$defs/PolicyRendered",
      "trigger_fired": "#/$defs/TriggerFired"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PolicyRendered"
    },
    {
      "$ref": "#/$defs/ConsultRequested"
    },
    {
      "$ref": "#/$defs/TriggerFired"
    },
    {
      "$ref": "#/$defs/BriefBuilt"
    },
    {
      "$ref": "#/$defs/AdvisorRequest"
    },
    {
      "$ref": "#/$defs/AdvisorResponse"
    },
    {
      "$ref": "#/$defs/AdvisorError"
    },
    {
      "$ref": "#/$defs/AdviceApplied"
    },
    {
      "$ref": "#/$defs/BudgetExhausted"
    }
  ]
}
