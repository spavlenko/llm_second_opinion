# Copy to .env (gitignored) and fill in. `bench` loads ../.env automatically; variables
# already exported in the shell win. Only variable names belong in experiment YAML files.

# Executor endpoint (OpenAI-compatible).
LOCAL_MODEL_URL=
LOCAL_API_KEY=
# Extra headers the executor endpoint needs: a non-secret one and a secret one. Header names
# are read from here too, so nothing about the inference setup is committed.
LOCAL_SESSION_HEADER=
LOCAL_SESSION=
LOCAL_AUTH_HEADER=
LOCAL_AUTH_KEY=

# Advisor endpoint (OpenAI-compatible).
ADVISOR_URL=
ADVISOR_API_KEY=

# MLflow (default http://127.0.0.1:5050, see scripts/mlflow-server.sh).
# MLFLOW_TRACKING_URI=
